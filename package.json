{
  "name": "ope-pharmacy-trainer",
  "version": "1.0.0",
  "description": "Entrenador OPE SAS 2025 — FEA Farmacia Hospitalaria",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "setup": "node server/db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "better-sqlite3": "^9.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "googleapis": "^140.0.0",
    "mammoth": "^1.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {}
}
